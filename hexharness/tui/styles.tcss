/* HexHarness TUI — OpenCode-like: dark, minimal chrome, one warm accent.
   Palette is declared as variables up top so the whole theme is swappable. */

$hh-background: #0d0d12;
$hh-panel: #16161d;
$hh-border: #2a2a34;
$hh-text: #c8c8d0;
$hh-muted: #6e6e7e;
$hh-accent: #d9894f;
$hh-success: #7fb069;
$hh-danger: #d9534f;
$hh-warning: #e0b54a;

Screen {
    background: $hh-background;
    color: $hh-text;
    layout: vertical;
}

/* thin header */
#header {
    dock: top;
    height: 1;
    padding: 0 1;
    background: $hh-panel;
    color: $hh-muted;
}

/* big transcript pane */
#transcript {
    height: 1fr;
    background: $hh-background;
    color: $hh-text;
    padding: 1 2;
    scrollbar-color: $hh-border;
    scrollbar-background: $hh-background;
}

/* live skill suggestions while typing a slash command */
#slash-suggest {
    display: none;
    height: auto;
    margin: 0 2;
    padding: 0 1;
    color: $hh-accent;
    background: $hh-panel;
}

/* bordered prompt box, accent when focused */
#prompt {
    dock: bottom;
    margin: 1 2;
    padding: 0 1;
    background: $hh-panel;
    color: $hh-text;
    border: round $hh-border;
}
#prompt:focus {
    border: round $hh-accent;
}
#prompt:disabled {
    color: $hh-muted;
}

Footer {
    background: $hh-panel;
    color: $hh-muted;
}
Footer > .footer--key {
    color: $hh-accent;
    background: $hh-panel;
}

/* --- modal: provider screen --- */
ProviderScreen {
    align: center middle;
}
#provider-panel {
    width: 80;
    max-width: 90%;
    height: 90%;          /* definite height so the scroll region can flex and buttons pin */
    padding: 1 2;
    background: $hh-panel;
    border: round $hh-accent;
}
#provider-scroll {
    height: 1fr;          /* takes the space between title and buttons; scrolls when full */
}
#provider-title {
    color: $hh-accent;
    padding-bottom: 1;
}
#prov-list {
    height: auto;
    max-height: 12;
    background: $hh-background;
    border: round $hh-border;
    margin-bottom: 1;
}
#prov-list > ListItem {
    background: $hh-background;
    color: $hh-text;
    padding: 0 1;
}
#prov-list > ListItem.--highlight {
    background: $hh-border;
    color: $hh-accent;
}
#router-list {
    height: auto;
    max-height: 7;
    background: $hh-background;
    border: round $hh-border;
    margin-bottom: 1;
}
#model-input, #secret-input {
    background: $hh-background;
    border: round $hh-border;
    margin-bottom: 1;
}
#model-input:focus, #secret-input:focus {
    border: round $hh-accent;
}
#register-row, #provider-buttons, #approval-buttons {
    height: auto;
    align-horizontal: left;
}
#provider-buttons {
    padding-top: 1;
}

/* --- modal: custom (bring-your-own) provider --- */
CustomProviderModal {
    align: center middle;
}
#custom-panel {
    width: 70;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    background: $hh-panel;
    border: round $hh-accent;
}
#custom-title {
    color: $hh-accent;
    padding-bottom: 1;
}
#custom-name, #custom-base-url, #custom-model, #custom-api-key {
    background: $hh-background;
    border: round $hh-border;
    margin-bottom: 1;
}
#custom-name:focus, #custom-base-url:focus, #custom-model:focus, #custom-api-key:focus {
    border: round $hh-accent;
}
#custom-buttons {
    height: auto;
    align-horizontal: left;
}

/* --- modal: mode (autonomy + phase) --- */
ModeScreen {
    align: center middle;
}
#mode-panel {
    width: 70;
    max-width: 90%;
    height: 90%;
    padding: 1 2;
    background: $hh-panel;
    border: round $hh-accent;
}
#mode-body { height: 1fr; }
#mode-title {
    color: $hh-accent;
    padding-bottom: 1;
}
#mode-lists {
    height: auto;
}
.mode-col {
    width: 1fr;
    height: auto;
}
#mode-autonomy, #mode-phase {
    height: auto;
    max-height: 9;
    background: $hh-background;
    border: round $hh-border;
    margin: 0 1 1 0;
}
#mode-buttons {
    height: auto;
    align-horizontal: left;
    padding-top: 1;
}

/* --- modal: approval --- */
ApprovalModal {
    align: center middle;
}
#approval-panel {
    width: 70;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    background: $hh-panel;
    border: round $hh-warning;
}
#approval-title {
    color: $hh-warning;
    padding-bottom: 1;
}
#approval-body {
    height: auto;
    max-height: 10;
    padding-bottom: 1;
}

/* --- modal: secret input --- */
SecretModal {
    align: center middle;
}
#secret-panel {
    width: 70;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    background: $hh-panel;
    border: round $hh-accent;
}
#secret-title {
    color: $hh-accent;
    padding-bottom: 1;
}
#secret-body {
    height: auto;
    max-height: 8;
    padding-bottom: 1;
}
#secret-value {
    background: $hh-background;
    border: round $hh-border;
    margin-bottom: 1;
}
#secret-value:focus {
    border: round $hh-accent;
}
#secret-buttons {
    height: auto;
    align-horizontal: left;
}

/* --- modal: capabilities (read-only) --- */
CapabilitiesScreen {
    align: center middle;
}
#capabilities-panel {
    width: 90;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $hh-panel;
    border: round $hh-accent;
}
#capabilities-title {
    color: $hh-accent;
    padding-bottom: 1;
}
#capabilities-body {
    height: auto;
    max-height: 30;
}
.cap-section {
    color: $hh-accent;
    padding-top: 1;
}

/* --- modal: findings (curation) --- */
FindingsScreen {
    align: center middle;
}
#findings-panel {
    width: 90;
    max-width: 95%;
    height: 90%;          /* definite height so the scroll flexes and buttons pin */
    padding: 1 2;
    background: $hh-panel;
    border: round $hh-accent;
}
#findings-scroll {
    height: 1fr;          /* space between title and buttons; scrolls when full */
}
#findings-title {
    color: $hh-accent;
    padding-bottom: 1;
}
#cand-list {
    height: auto;
    max-height: 12;
    background: $hh-background;
    border: round $hh-border;
    margin-bottom: 1;
}
#cand-list > ListItem {
    background: $hh-background;
    color: $hh-text;
    padding: 0 1;
}
#cand-list > ListItem.--highlight {
    background: $hh-border;
    color: $hh-accent;
}
#confirmed-box, #rejected-box {
    height: auto;
}
#findings-buttons {
    height: auto;
    align-horizontal: left;
    padding-top: 1;
}

Button {
    margin-right: 2;
}

.dim {
    color: $hh-muted;
}

/* modal: scope-change approval */
ScopeApprovalModal { align: center middle; }
#scope-panel {
    width: 76;
    max-width: 90%;
    height: 80%;
    padding: 1 2;
    background: $hh-panel;
    border: round $hh-warning;
}
#scope-title { color: $hh-warning; padding-bottom: 1; }
#scope-body { height: 1fr; }
#scope-buttons { height: auto; padding-top: 1; align-horizontal: left; }

/* modal: manual scope editor */
ScopeEditScreen { align: center middle; }
#scope-edit-panel {
    width: 80;
    max-width: 90%;
    height: 90%;          /* definite height so the scroll flexes and buttons pin */
    padding: 1 2;
    background: $hh-panel;
    border: round $hh-accent;
}
#scope-edit-title { color: $hh-accent; padding-bottom: 1; }
#scope-edit-body { height: 1fr; }
.scope-add-row { height: auto; align-horizontal: left; margin-bottom: 1; }
.scope-add-row > Input {
    width: 1fr;
    background: $hh-background;
    border: round $hh-border;
}
.scope-add-row > Input:focus { border: round $hh-accent; }
#scope-entries {
    height: auto;
    max-height: 12;
    background: $hh-background;
    border: round $hh-border;
    margin-bottom: 1;
}
#scope-entries > ListItem { background: $hh-background; color: $hh-text; padding: 0 1; }
#scope-entries > ListItem.--highlight { background: $hh-border; color: $hh-accent; }
#scope-edit-buttons { height: auto; padding-top: 1; align-horizontal: left; }

/* toggleable commands side panel (Ctrl+B) */
#command-panel {
    display: none;
    dock: left;
    width: 46;
    max-width: 60%;
    height: 100%;
    padding: 1 2;
    background: $hh-panel;
    border-right: round $hh-accent;
    color: $hh-text;
}

/* model reasoning (dim) shown live above the answer */
#thinking {
    height: auto;
    max-height: 8;
    margin: 0 2;
    padding: 0 1;
    color: $hh-muted;
    background: $hh-background;
}

/* status line: working / thinking / running tool / ready */
#status {
    height: 1;
    margin: 0 2;
    padding: 0 1;
    color: $hh-muted;
    background: $hh-panel;
}
